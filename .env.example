# Runtime
GUARDIANLENS_ENV=development
# stub = explicit development scores; trained = the saved models (see docs/TRAINED_MODELS.md).
GUARDIANLENS_INFERENCE_MODE=stub
# GUARDIANLENS_MODEL_RUN_DIR=C:/path/to/20261002_062026_colab_v3_noMeta
# Optional: defaults to the sibling GuardianLens_Training workspace.
# GUARDIANLENS_TRAINING_WORKSPACE=C:/path/to/GuardianLens_Training
# Optional: the SQLite file for sessions, assessments and feedback. Defaults to data/guardianlens.sqlite3.
# GUARDIANLENS_DATABASE_PATH=data/guardianlens.sqlite3
# A JSON list, or several origins separated by commas: https://site.example,https://other.example
GUARDIANLENS_ALLOWED_ORIGINS=["http://localhost:3000"]
GUARDIANLENS_SESSION_COOKIE=guardianlens_session
GUARDIANLENS_MAX_IMAGES=10
GUARDIANLENS_MAX_IMAGE_BYTES=5242880
GUARDIANLENS_TITLE_MAX_LENGTH=500
GUARDIANLENS_DESCRIPTION_MAX_LENGTH=5000
GUARDIANLENS_CATEGORY_MAX_LENGTH=80
GUARDIANLENS_RATE_LIMIT_PER_MINUTE=6
GUARDIANLENS_RATE_LIMIT_PER_IP_PER_MINUTE=30

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
