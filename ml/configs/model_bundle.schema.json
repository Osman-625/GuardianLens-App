{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GuardianLens model bundle manifest",
  "type": "object",
  "required": [
    "label",
    "dataset_version",
    "seed",
    "visual_version",
    "textual_version",
    "behavioural_version",
    "fusion_version",
    "calibrator_version",
    "explanation_templates_version",
    "category_baselines",
    "band_boundaries",
    "artifact_hashes",
    "dependency_lock_hash"
  ],
  "properties": {
    "label": { "type": "string", "minLength": 1 },
    "dataset_version": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer" },
    "visual_version": { "type": "string", "minLength": 1 },
    "textual_version": { "type": "string", "minLength": 1 },
    "behavioural_version": { "type": "string", "minLength": 1 },
    "fusion_version": { "type": "string", "minLength": 1 },
    "calibrator_version": { "type": "string", "minLength": 1 },
    "explanation_templates_version": { "type": "string", "minLength": 1 },
    "category_baselines": { "type": "object" },
    "band_boundaries": {
      "type": "object",
      "required": ["low_max", "moderate_max"],
      "properties": {
        "low_max": { "type": "integer", "minimum": 0, "maximum": 99 },
        "moderate_max": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "dependency_lock_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "development_stub": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
